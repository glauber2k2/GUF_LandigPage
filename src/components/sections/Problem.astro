---
import type { SectionOf } from "../../content/schemas/sections";
import Container from "../ui/Container.astro";
import Heading from "../ui/Heading.astro";
import InlineText from "../ui/InlineText.astro";
import Section from "../ui/Section.astro";

interface Props {
  data: SectionOf<"problem">;
}

const { data } = Astro.props;
---

<Section labelledBy="dor-title">
  <Container size="narrow" class="flex flex-col gap-10">
    <div data-reveal>
      <Heading id="dor-title" text={data.title} />
    </div>
    <ul class="m-0 grid list-none border-t border-line p-0">
      {data.items.map((item) => (
        <li data-reveal class="border-b border-line py-[22px] text-[clamp(18px,2.4vw,22px)] leading-[1.45] text-fg-2">
          {item}
        </li>
      ))}
    </ul>
    <p data-reveal class="m-0 text-[clamp(22px,3vw,30px)] leading-[1.3] font-semibold text-balance">
      <InlineText text={data.closing} />
    </p>
  </Container>
</Section>
