---
import type { SectionOf } from "../../content/schemas/sections";

/** Faixa grafite com três fatos grandes (registro rápido, tudo num app, treino sem sinal); só o primeiro em volt. */
interface Props {
  data: SectionOf<"facts">;
}

const { data } = Astro.props;
---

<section aria-labelledby="facts-title" class="border-y border-ink-4 bg-deep px-5 py-[clamp(72px,10vw,110px)] text-snow">
  <div class="mx-auto max-w-page">
    <h2 id="facts-title" data-reveal class="m-0 mb-10 text-xs font-bold tracking-[0.08em] text-volt uppercase">
      {data.eyebrow}
    </h2>
    <ul class="m-0 grid list-none gap-6 p-0 md:grid-cols-3">
      {data.items.map((item) => (
        <li data-reveal class="fact border-t border-ink-4 pt-6">
          <p class="m-0 font-display text-[clamp(84px,10vw,150px)] leading-[0.86] font-bold text-snow uppercase">
            {item.value}
          </p>
          <p class="m-0 mt-4 text-lg leading-[27px] text-mist">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Só o primeiro fato em volt: o verde fica como destaque, não como fundo. */
  .fact:first-child p:first-child {
    color: var(--vitrine-volt);
  }
</style>
