---
import { site } from "../../config/site";
import type { PlanCatalog } from "../../content/schemas/app-data";
import type { SectionOf } from "../../content/schemas/sections";
import { activePrice, defaultPlan, formatIntervalSuffix, formatMoney, upgradePlan } from "../../lib/domain/plans";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import InlineText from "../ui/InlineText.astro";

/**
 * Comparação Free × Pro na vitrine (Free em papel, Pro em grafite). Nomes, limites e preço vêm do
 * catálogo do app (plans, plan_features, plan_prices). Sem preço ativo, o Pro mostra "chega em breve",
 * exatamente como o app faz. Sem preço riscado, desconto ou contador: o app não tem nada disso.
 * Pré-lançamento (site.launch.showProPrice false): o valor aparece como "R$ ??,??".
 */
interface Props {
  data: SectionOf<"plans">;
  catalog: PlanCatalog;
}

const { data, catalog } = Astro.props;
const free = defaultPlan(catalog);
const pro = upgradePlan(catalog);
const price = activePrice(catalog, pro.code);
---

<section id={data.anchor} aria-labelledby="plans-title" class="bg-volt px-5 py-[clamp(72px,10vw,120px)] text-ink">
  <div class="mx-auto max-w-page">
    <h2
      id="plans-title"
      data-reveal
      class="m-0 font-display text-[clamp(52px,7vw,104px)] leading-[0.86] font-bold uppercase"
    >
      {data.title[0]}
      <br />
      {data.title[1]}
    </h2>
    <p data-reveal class="m-0 mt-5 max-w-[56ch] text-lg leading-7 text-on-volt-soft">
      {data.lead}
    </p>

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      <article data-reveal class="flex flex-col gap-5 rounded-[32px] bg-paper p-7 text-ink md:p-9">
        <div class="flex flex-col gap-1.5">
          <h3 class="m-0 text-xs font-bold tracking-[0.08em] text-on-paper-soft uppercase">{free.name}</h3>
          <p class="m-0 font-display text-[80px] leading-[0.9] font-bold">R$ 0</p>
          <span class="text-[15px] text-on-paper-soft">{data.free.tagline}</span>
        </div>
        <ul class="m-0 flex flex-1 list-none flex-col gap-3 p-0 text-[15px] leading-[1.45]">
          {data.free.features.map((feature) => (
            <li class="flex gap-2.5">
              <Icon name="check" size={18} strokeWidth={2.6} class="mt-0.5 text-volt-deep" />
              <span>
                <InlineText text={feature} strongClass="font-semibold text-ink" />
              </span>
            </li>
          ))}
        </ul>
        <Button cta={data.free.cta} source="planos-free" variant="ink" size="lg" pill block />
      </article>

      <article data-reveal class="flex flex-col gap-5 rounded-[32px] bg-ink p-7 text-snow md:p-9">
        <div class="flex flex-col gap-1.5">
          <h3 class="m-0 flex items-center gap-2 text-xs font-bold tracking-[0.08em] text-volt uppercase">
            {pro.name}
            <Icon name="crown" size={16} class="text-gold" />
          </h3>
          {price && (
            <p class="m-0 flex items-baseline gap-2">
              <span class="font-display text-[80px] leading-[0.9] font-bold text-volt">
                {site.launch.showProPrice ? (
                  formatMoney(price.amount_cents, price.currency)
                ) : (
                  <>
                    <span aria-hidden="true">{site.launch.priceMask}</span>
                    <span class="sr-only">{site.launch.priceMaskLabel}</span>
                  </>
                )}
              </span>
              <span class="text-[15px] text-mist">{formatIntervalSuffix(price)}</span>
            </p>
          )}
          <span class="text-[15px] text-mist">{data.pro.tagline}</span>
        </div>
        <ul class="m-0 flex flex-1 list-none flex-col gap-3 p-0 text-[15px] leading-[1.45]">
          {data.pro.features.map((feature) => (
            <li class="flex gap-2.5">
              <Icon name="plus" size={18} strokeWidth={2.6} class="mt-0.5 text-volt" />
              <span>
                <InlineText text={feature} strongClass="font-semibold text-snow" />
              </span>
            </li>
          ))}
        </ul>
        {price ? (
          <>
            <ul class="m-0 flex list-none flex-col gap-2 p-0 text-[13px] leading-snug text-mist">
              {data.pro.guarantees.map((g) => (
                <li class="flex items-center gap-2">
                  <Icon name={g.icon} size={16} class="text-volt" />
                  {g.text}
                </li>
              ))}
            </ul>
            <Button cta={data.pro.cta} source="planos-pro" variant="volt" size="lg" pill block />
          </>
        ) : (
          <p class="m-0 flex h-14 items-center justify-center rounded-full border border-dashed border-ink-line-strong px-3 text-center text-[15px] font-semibold text-mist">
            {data.pro.unavailable}
          </p>
        )}
      </article>
    </div>
  </div>
</section>
