---
import type { UiContent } from "../../content/schemas/sections";
import Button from "../ui/Button.astro";
import Logo from "../ui/Logo.astro";

/**
 * Cabeçalho da vitrine: uma pílula grafite translúcida que flutua no topo, com a marca, os atalhos das seções
 * (escondidos no celular, onde só ficam a marca e o botão) e o CTA de cadastro.
 */
interface Props {
  ui: UiContent["header"];
}

const { ui } = Astro.props;
---

<header class="pointer-events-none fixed inset-x-0 top-3 z-50 flex justify-center px-3">
  <div class="pointer-events-auto flex items-center gap-1.5 rounded-full border border-snow-tint bg-glass py-1.5 pr-1.5 pl-4 shadow-toast backdrop-blur-md">
    <a href="#topo" aria-label={ui.homeLabel} class="flex min-h-11 items-center pr-2">
      <Logo height={26} label="" tone="onInk" class="pointer-events-none" />
    </a>
    <nav aria-label={ui.navLabel} class="hidden items-center md:flex">
      {ui.links.map((link) => (
        <a
          href={link.anchor}
          class="flex min-h-11 items-center rounded-full px-3.5 text-sm font-semibold text-mist transition-colors duration-150 hover:bg-ink-3 hover:text-snow"
        >
          {link.label}
        </a>
      ))}
    </nav>
    <Button cta={ui.signup} source="header" variant="volt" size="sm" pill class="px-[18px]" tooltipSide="bottom" />
  </div>
</header>
