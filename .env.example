# Copie para .env e preencha. Nada aqui é segredo: tudo vai para o HTML público.

# Domínio final da landing (canonical, Open Graph, sitemap, robots.txt e JSON-LD).
# Sem valor, o build usa http://localhost:4321 e avisa no log. Obrigatório antes de publicar.
PUBLIC_SITE_URL=

# Endereço do app (todos os botões "Começar grátis", "Entrar" etc. apontam para ele).
# Padrão: https://gufapp.vercel.app
PUBLIC_APP_URL=

# Analytics: sem ID, nenhum script de rastreamento é carregado e o aviso de cookies não aparece.
PUBLIC_META_PIXEL_ID=
PUBLIC_GA_ID=

# Verificação do Google Search Console (só o código do content="…" da meta tag).
PUBLIC_GSC_VERIFICATION=

# Sincronização dos planos no build (scripts/sync-app-data.ts). Usa a chave PÚBLICA (publishable),
# a mesma do app; o RLS do Supabase só libera leitura do catálogo de planos e dos preços ativos.
# Sem essas variáveis, o build usa o último snapshot versionado em src/content/plans/catalog.json.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
